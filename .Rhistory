# Boxplot épuré
geom_boxplot(alpha = 0.7, outlier.size = 0.5, width = 0.6) +
# Le coeur de la demande : Lignes = Contexte, Colonnes = Phénotype
facet_grid(context ~ trait) +
# Ajout des médianes
stat_summary(
fun = median,
geom = "text",
aes(label = sprintf("%.2f", ..y..)),
vjust = -3.5,
size = 3,
fontface = "bold"
) +
# Échelles et Couleurs
scale_y_continuous(limits = c(0, 1.1), breaks = seq(0, 1, 0.2)) +
scale_fill_manual(values = c(
"FarmCPU" = "#4DAF4A",
"MLM" = "#377EB8",
"Random" = "#999999"
)) +
# Cosmétique académique
theme_bw() +
labs(
title = "Impact de la déflation de la structure de population",
subtitle = "Comparaison des R2 sur phénotypes bruts (haut) vs résidus (bas)",
x = "Procédure de sélection",
y = expression(bold(R^2) ~ "de prédiction (CV)"),
fill = "Méthode"
) +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
legend.position = "bottom",
strip.background = element_rect(fill = "gray90"),
strip.text = element_text(face = "bold", size = 10),
panel.spacing = unit(1, "lines")
)
